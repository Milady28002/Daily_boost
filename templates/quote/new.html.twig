{% extends 'base.html.twig' %}

{% block title %}Ajouter une citation{% endblock %}

{% block body %}

<div class="auth-container">
    <div class="auth-card">

        <h1>Ajouter une citation</h1>

        {{ form_start(form) }}

            {{ form_row(form.title) }}
            {{ form_row(form.content) }}
            {{ form_row(form.author) }}

            <button type="submit" class="btn primary">
                Enregistrer
            </button>

        {{ form_end(form) }}

    </div>
</div>

{% endblock %}