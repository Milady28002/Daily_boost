{% extends 'base.html.twig' %}

{% block title %}Toutes les citations{% endblock %}

{% block body %}
<h1>Toutes les citations</h1>

{% if quotes is empty %}
  <p>Aucune citation pour le moment.</p>
{% else %}
  <ul style="display:grid; gap:12px; padding-left:0; list-style:none;">
    {% for quote in quotes %}
      <li class="card" style="padding:16px;">
        <p style="margin:0 0 6px 0; font-size:18px;">
          <strong>{{ quote.title }}</strong> — “{{ quote.content }}”
        </p>

        <p style="margin:0; color: var(--muted);">
          {% if quote.author %}— {{ quote.author }}{% else %}— New Daily Boost{% endif %}
        </p>

        <div style="margin-top:10px; display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
          <a class="btn" href="{{ path('quote_toggle_favorite', {id: quote.id}) }}">
            {% if quote.isFavorite %}
              ⭐ Retirer des favoris
            {% else %}
              ☆ Mettre en favoris
            {% endif %}
          </a>
        {% if is_granted('ROLE_ADMIN') %}
          <a class="btn" href="{{ path('quote_edit', {id: quote.id}) }}">
            ✏️ Modifier
          </a>
          
          <form method="post"
                action="{{ path('quote_delete', {id: quote.id}) }}"
                onsubmit="return confirm('Supprimer cette citation ?');"
                style="display:inline;">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_quote_' ~ quote.id) }}">
            <button type="submit" class="btn">🗑️ Supprimer</button>
          </form>
        {% endif %}
        </div>
      </li>
    {% endfor %}
  </ul>
{% endif %}
{% endblock %}