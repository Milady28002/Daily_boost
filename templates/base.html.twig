```twig
{# templates/base.html.twig #}
<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}New Daily Boost{% endblock %}</title>

    <style>
        :root {
            --bg: #fbf7f1;
            --card: #ffffff;
            --text: #2b2b2b;
            --muted: #6c6c6c;
            --line: #ece2d6;
            --accent: #4f7d69;
            --accent2: #c07a5b;
            --shadow: 0 14px 40px rgba(43, 43, 43, .10);
            --radius: 18px;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
            background:
                radial-gradient(900px 500px at 20% 10%, rgba(79, 125, 105, .10), transparent 55%),
                radial-gradient(700px 450px at 85% 15%, rgba(192, 122, 91, .10), transparent 55%),
                var(--bg);
            color: var(--text);
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .container {
            width: min(980px, 92vw);
            margin: 0 auto;
        }

        .nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 18px 0;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
            letter-spacing: .2px;
        }

        .dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            box-shadow: 0 0 0 5px rgba(79, 125, 105, .12);
        }

        .nav-links {
            display: flex;
            gap: 12px;
        }

        .pill {
            padding: 8px 12px;
            border: 1px solid var(--line);
            border-radius: 999px;
            background: rgba(255, 255, 255, .65);
        }

        .pill:hover {
            border-color: rgba(79, 125, 105, .35);
        }

        main {
            padding: 18px 0 44px;
        }

        .hero {
            display: grid;
            gap: 16px;
            padding: 26px;
            border: 1px solid var(--line);
            border-radius: var(--radius);
            background: rgba(255, 255, 255, .85);
            box-shadow: var(--shadow);
        }

        .kicker {
            color: var(--muted);
            font-weight: 600;
            letter-spacing: .6px;
            text-transform: uppercase;
            font-size: 12px;
        }

        h1 {
            margin: 0;
            font-size: clamp(28px, 4vw, 44px);
            line-height: 1.08;
        }

        .lead {
            margin: 0;
            color: var(--muted);
            font-size: 16px;
            line-height: 1.7;
            max-width: 60ch;
        }

        .cta-row {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 4px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 14px;
            border-radius: 14px;
            border: 1px solid var(--line);
            background: rgba(255, 255, 255, .75);
            font-weight: 600;
        }

        .btn.primary {
            border: none;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            color: #fff;
            box-shadow: 0 10px 22px rgba(79, 125, 105, .22);
        }

        .btn:hover {
            transform: translateY(-1px);
        }

        .btn:active {
            transform: translateY(0);
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(12, 1fr);
            gap: 14px;
            margin-top: 14px;
        }

        .card {
            grid-column: span 6;
            padding: 20px;
            border: 1px solid var(--line);
            border-radius: 16px;
            background: rgba(255, 255, 255, .9);
            font-style: italic;
        }

        .card h3 {
            margin: 0 0 6px;
            font-size: 16px;
        }

        .card p {
            margin: 0;
            color: var(--muted);
            line-height: 1.6;
        }

        footer {
            padding: 18px 0 30px;
            color: rgba(43, 43, 43, .55);
            border-top: 1px solid var(--line);
        }

        .footer-content {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
            text-align: center;
        }

        .footer-links {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 8px;
        }

        .footer-links a {
            color: var(--muted);
        }

        .footer-links a:hover {
            color: var(--accent);
            text-decoration: underline;
        }

        code.badge {
            padding: 2px 8px;
            border-radius: 999px;
            border: 1px solid var(--line);
            background: rgba(255, 255, 255, .7);
            color: rgba(43, 43, 43, .78);
        }

        /* ===== Pages légales ===== */

        .legal-page {
            max-width: 820px;
            margin: 30px auto;
            padding: 40px;
            border: 1px solid var(--line);
            border-radius: var(--radius);
            background: rgba(255, 255, 255, .9);
            box-shadow: var(--shadow);
        }

        .legal-page h1 {
            margin-bottom: 30px;
        }

        .legal-page h2 {
            margin-top: 32px;
            margin-bottom: 12px;
            font-size: 20px;
        }

        .legal-page p,
        .legal-page li {
            color: var(--muted);
            line-height: 1.7;
        }

        .legal-page a {
            color: var(--accent);
            text-decoration: underline;
        }

        .flash-success {
            background: #dff5e1;
            color: #2f6b35;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .main-nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            padding: 18px 0;
        }

        .nav-left,
        .nav-right {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
            white-space: nowrap;
        }

        .brand-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            box-shadow: 0 0 0 5px rgba(79, 125, 105, .12);
        }

        .user-info {
            color: var(--muted);
            font-size: 14px;
        }

        /* ===== Formulaires Connexion / Inscription / Citation ===== */

        .auth-container {
            display: flex;
            justify-content: center;
            margin-top: 40px;
        }

        .auth-card {
            width: 100%;
            max-width: 500px;
            padding: 40px;
            border-radius: 20px;
            background: rgba(255, 255, 255, .85);
            border: 1px solid var(--line);
            box-shadow: var(--shadow);
        }

        .auth-card h1 {
            text-align: center;
            margin-bottom: 30px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label,
        .auth-card form > div > label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .form-group input,
        .auth-card input,
        .auth-card textarea {
            width: 100%;
            display: block;
            padding: 12px 16px;
            border: 1px solid var(--line);
            border-radius: 14px;
            background: white;
            font-size: 15px;
            font-family: inherit;
        }

        .auth-card textarea {
            min-height: 140px;
            resize: vertical;
        }

        .auth-card form > div {
            margin-bottom: 20px;
        }

        .auth-card input[type="checkbox"] {
            width: auto;
            display: inline-block;
            padding: 0;
        }

        .remember-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin: 25px 0;
        }

        .remember-row input {
            width: auto;
            margin: 0;
        }

        .remember-row label {
            margin: 0;
            cursor: pointer;
        }

        .auth-card .btn {
            width: 100%;
            justify-content: center;
        }

        .flash-error {
            background: #fde7e7;
            color: #8d2f2f;
            padding: 12px;
            border-radius: 10px;
            margin-bottom: 20px;
        }

        .checkbox-row > div {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin: 25px 0;
        }

        .checkbox-row input[type="checkbox"] {
            width: auto;
            margin: 0;
        }

        .checkbox-row label {
            margin: 0;
            cursor: pointer;
        }

        .checkbox-row a,
        .privacy-info a {
            color: var(--accent);
            text-decoration: underline;
        }

        .privacy-info {
            margin: 20px 0;
            padding: 14px 16px;
            border-left: 3px solid var(--accent);
            border-radius: 8px;
            background: rgba(79, 125, 105, .06);
        }

        .privacy-info p {
            margin: 0;
            color: var(--muted);
            font-size: 13px;
            line-height: 1.6;
        }

        .privacy-info p + p {
            margin-top: 6px;
        }

        .delete-account-link {
            padding: 0;
            border: 0;
            background: none;
            color: #a94442;
            font-size: 12px;
            text-decoration: underline;
            cursor: pointer;
        }

        .delete-account-link:hover {
            opacity: .75;
        }

        @media (max-width: 700px) {
            .container {
                width: 92vw;
            }

            .nav-links {
                display: none;
            }

            .main-nav {
                flex-direction: column;
                align-items: center;
                text-align: center;
                gap: 14px;
            }

            .nav-left,
            .nav-right {
                justify-content: center;
                width: 100%;
            }

            .hero {
                display: flex;
                flex-direction: column;
                padding: 20px;
                overflow: hidden;
            }

            .hero > * {
                width: 100%;
                max-width: 100%;
            }

            .cta-row {
                flex-direction: column;
                width: 100%;
            }

            .cta-row .btn,
            .btn {
                width: 100%;
                justify-content: center;
                white-space: normal;
            }

            .lead {
                max-width: 100%;
            }

            .grid {
                grid-template-columns: 1fr;
            }

            .card {
                grid-column: span 1;
                width: 100%;
                max-width: 100%;
            }

            h1 {
                font-size: 32px;
            }

            .auth-card {
                padding: 25px;
            }

            .legal-page {
                padding: 25px;
            }
        }
    </style>
</head>

<body>
    {% for message in app.flashes('success') %}
        <div class="flash-success">
            {{ message }}
        </div>
    {% endfor %}

    <header class="container">
        <nav class="main-nav">
            <div class="nav-left">
                <a href="{{ path('home') }}">🏠 Accueil</a>
                <a href="{{ path('quote_list') }}">📚 Toutes les citations</a>
                <a href="{{ path('favorites') }}">⭐ Favoris</a>

                {% if is_granted('ROLE_USER') %}
                    <a href="{{ path('quote_new') }}">➕ Ajouter</a>
                {% endif %}

                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('quote_stats') }}">📊 Stats</a>
                {% endif %}
            </div>

            <div class="nav-brand">
                <span class="brand-dot"></span>
                <strong>New Daily Boost</strong>
            </div>

            <div class="nav-right">
                {% if app.user %}
                    <span class="user-info">{{ app.user.userIdentifier }}</span>

                    <a class="pill" href="{{ path('app_logout') }}">
                        Déconnexion
                    </a>

                    <form
                        method="post"
                        action="{{ path('account_delete') }}"
                        onsubmit="return confirm('Voulez-vous vraiment supprimer définitivement votre compte Daily Boost ? Cette action est irréversible.');"
                    >
                        <input
                            type="hidden"
                            name="_token"
                            value="{{ csrf_token('delete_account_' ~ app.user.id) }}"
                        >

                        <button type="submit" class="delete-account-link">
                            Supprimer mon compte
                        </button>
                    </form>
                {% else %}
                    <a class="pill" href="{{ path('app_login') }}">Connexion</a>
                    <a class="pill" href="{{ path('app_register') }}">Inscription</a>
                {% endif %}
            </div>
        </nav>
    </header>

    <main class="container">
        {% block body %}{% endblock %}
    </main>

    <footer class="container">
        <div class="footer-content">

            <div class="footer-info">
                <span>By Milady</span>
                · <code class="badge">Symfony {{ constant('Symfony\\Component\\HttpKernel\\Kernel::VERSION') }}</code>
                · <span>{{ "now"|date("Y") }}</span>
            </div>

            <nav class="footer-links" aria-label="Informations légales">
                <a href="{{ path('privacy_policy') }}">
                    Politique de confidentialité
                </a>

                <span>·</span>

                <a href="{{ path('legal_notice') }}">
                    Mentions légales
                </a>

                <span>·</span>

                <a href="{{ path('terms') }}">
                    Conditions d'utilisation
                </a>
            </nav>

        </div>
    </footer>
</body>

</html>
```
